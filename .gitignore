# Outputs and caches
out/
cache/

# Audio (never commit recordings)
*.m4a
*.mp3
*.wav
*.opus
*.ogg
*.flac
*.mp4

# Transcript outputs (belt + braces if files end up outside out/)
*.txt
*.srt
*.vtt
*.tsv
*.json
*.diff
*.corrected.txt

# Legacy cache locations
.transcribe-cache/
.correct-cache/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Allow project files explicitly
!README.md
!.gitignore

# Test fixtures: short, non-sensitive audio + hand-corrected reference
!tests/fixtures/**/audio.*
!tests/fixtures/**/reference.json
!tests/baselines.json
