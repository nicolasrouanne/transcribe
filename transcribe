#!/usr/bin/env bash
# transcribe — local WhisperX with stage-level caching.
# Usage: transcribe <audio-file> [lang] [output-dir]
#   lang       defaults to 'fr'. Use 'auto' to autodetect.
#   output-dir defaults to current directory.
#
# Stages (transcribe / align / diarise) are cached to
#   <output-dir>/.transcribe-cache/<fingerprint>/
# so an interrupted run resumes from the last completed stage.
#
# Diarisation requires ~/.config/whisperx/token (HF read token + accepted
# terms on pyannote/speaker-diarization-community-1). Run with --no-diarize
# to skip.

set -euo pipefail

[ $# -lt 1 ] && {
  echo "Usage: $(basename "$0") <audio-file> [lang] [output-dir] [--no-diarize]" >&2
  exit 1
}

# Resolve symlinks so script_dir points to the real install location even
# when invoked through ~/.local/bin/transcribe.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  link_dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ $source != /* ]] && source="$link_dir/$source"
done
script_dir="$(cd -P "$(dirname "$source")" && pwd)"
whisperx_python="$(uv tool dir 2>/dev/null)/whisperx/bin/python"

[ -x "$whisperx_python" ] || {
  echo "WhisperX python not found at $whisperx_python" >&2
  echo "Install with: uv tool install whisperx" >&2
  exit 1
}

input="$1"; shift
lang="${1:-fr}"; [ $# -gt 0 ] && shift || true
output_dir="${1:-.}"; [ $# -gt 0 ] && shift || true

exec "$whisperx_python" "$script_dir/transcribe.py" \
  --lang "$lang" \
  --output-dir "$output_dir" \
  "$@" \
  "$input"
